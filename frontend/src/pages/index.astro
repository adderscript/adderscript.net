---
import NavButton from '../components/NavButton.astro';
import SocialsButton from '../components/SocialsButton.astro';
import UserCounter from '../components/UserCounter.astro';
import Comic from '../components/Comic.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- pages -->
	<div class="m-3 flex flex-wrap gap-6 justify-center">
		<NavButton name="GAMES" page="/games" icon="/icons/games.svg" />
		<NavButton name="ABOUT ME" page="/aboutme" icon="/icons/aboutme.svg" />
		<NavButton name="UNDER CONSTRUCTION" page="/" icon="/icons/book.svg" />
	</div>
	
	<!-- socials -->
	<div class="m-3 mb-20 flex flex-wrap gap-6 justify-center">
		<SocialsButton name="GITHUB" link="https://github.com/adderscript" icon="/icons/github.svg" />
		<SocialsButton name="EMAIL" link="mailto:alasdair@adderscript.net" icon="/icons/email.svg" />
		<SocialsButton name="BUY ME A COFFEE" link="https://buymeacoffee.com/AdderScript" icon="/icons/coffee.svg" />
	</div>
	
	<Comic />
</Layout>
