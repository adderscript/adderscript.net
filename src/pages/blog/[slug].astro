---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: { slug: post.slug },
  	}));
}

const { slug } = Astro.params;
const post = (await getCollection("blog")).find(p => p.slug === slug);

if (!post) {
	throw new Error(`Post not found for slug: ${slug}`);
}

const { Content } = await post.render();
---

<Layout>
	<h1 class="mb-7 text-2xl text-center text-accent-muted font-bold">{post.data.title}</h1>
	<article class="prose prose-invert p-10 text-left bg-surface-1 rounded-lg border-2 border-accent-muted">
		<Content />
	</article>
</Layout>