---
interface Props {
    name: string;
    link: string;
    icon: string;
}

const { name, link, icon } = Astro.props as Props;
---

<a href={link} class="flex gap-2 px-6 py-3 bg-nav-button hover:bg-nav-button-hover
    border-2 border-accent-muted
    rounded-md transition-all duration-100
    text-text-secondary font-bold hover:text-text-primary"
>
    <img src={icon} alt="icon" class="w-6 h-6" />
    {name}
</a>